# IMM Environment Configuration Template
# Copy this file to .env and fill in your actual settings.

# Instagram Authentication (Optional if using session ID)
INSTAGRAM_USERNAME=your_username_here
INSTAGRAM_PASSWORD=your_password_here
INSTAGRAM_SESSION_ID=

# Safety & Operational Settings
DRY_RUN=True
LOG_LEVEL=INFO
DATABASE_PATH=data/imm.db

# Rate Limiting Constraints
MAX_COMMENTS_PER_HOUR=10
MAX_COMMENTS_PER_DAY=50
